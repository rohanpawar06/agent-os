# Generate a per-user API key with: node scripts/create-tenant-key.mjs <tenant-id>
# Put the returned SHA-256 hash here. Give the raw token to that user privately.
AGENTOS_TENANT_KEYS='{"rohan":"replace-with-64-character-sha256-hash"}'

# Grants are deny-by-default. Prefer explicit tool names; use category.* only if intended.
AGENTOS_TOOL_GRANTS='{"rohan":["filesystem.list_directory","filesystem.read_file","filesystem.search_files","filesystem.create_directory","filesystem.write_file","documents.read_document","documents.create_document","documents.append_document","spreadsheets.read_spreadsheet","spreadsheets.create_spreadsheet","spreadsheets.append_spreadsheet_row","spreadsheets.filter_spreadsheet"]}'

# Public origin of the Next.js UI. Terminate HTTPS at your hosting provider or reverse proxy.
AGENTOS_PUBLIC_ORIGIN=https://agentos.example.com
FRONTEND_PORT=3000
OLLAMA_MODEL=qwen3.5:9b
# Optional live search. Create a free Ollama account/API key to enable web search.
OLLAMA_API_KEY=
# Thinking is used by supported Qwen3 / DeepSeek-R1 model versions.
AGENTOS_MODEL_THINKING=medium
# Keep 0 to use the model default; larger contexts need more memory.
AGENTOS_CONTEXT_TOKENS=0
AGENTOS_TEMPERATURE=0.3
